# ---------------------------------------------------------------------------
# Copy to .env for local development. Never commit .env.
# In production these come from Cloud Run env vars + Secret Manager (see cloudbuild.yaml).
# Local dev talks to REAL Google Cloud resources in the team project (it473-capstone-project):
#   - Firestore, Firebase Auth and Cloud Storage through Application Default Credentials:
#       gcloud auth application-default login --disable-quota-project
#   - Cloud SQL through the Cloud SQL Auth Proxy  (npm run db:proxy). Optional for browsing:
#     the storefront renders the catalog from Firestore alone and hides stock without it.
# ---------------------------------------------------------------------------

# Public URL of the site (used for Stripe redirect URLs)
SITE_URL=http://localhost:3000

# Comma-separated staff emails allowed into /admin
ADMIN_EMAILS=admin@prairiecrestfoods.example

# --- Google Cloud / Firebase ---------------------------------------------
# The team's GCP project (Firebase is enabled on it). These are also the code defaults.
GOOGLE_CLOUD_PROJECT=it473-capstone-project
FIREBASE_PROJECT_ID=it473-capstone-project
# From Firebase console > Project settings > General > Your apps > Web app
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=it473-capstone-project.firebaseapp.com
FIREBASE_APP_ID=
# Private bucket with product photos (products/{sku-id}/images/primary.jpg), served via /media
GCS_BUCKET=it473-capstone-project-media

# Dev only: show wholesale prices to guests so the price UI can be reviewed before
# sign-in works. Ignored when NODE_ENV=production.
SHOW_PRICES_TO_GUESTS=
# Starting stock for catalog items that `npm run seed` finds without a stock row.
SEED_DEFAULT_STOCK=40

# --- Cloud SQL (PostgreSQL) -----------------------------------------------
# Local dev: run `npm run db:proxy` first, then connect through 127.0.0.1:5432
CLOUD_SQL_CONNECTION_NAME=it473-capstone-project:us-central1:foodhub-pg
DATABASE_URL=postgresql://app:CHANGE_ME@127.0.0.1:5432/foodhub
# Cloud Run uses the unix socket instead (set by cloudbuild.yaml / Secret Manager):
# DATABASE_URL=postgresql://app:PASSWORD@localhost/foodhub?host=/cloudsql/PROJECT:REGION:INSTANCE

# --- Stripe (test mode) ---------------------------------------------------
# Leave blank to skip the payment step (orders are still recorded as PENDING_PAYMENT).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
