# ---------------------------------------------------------------------------
# Copy to .env for local development. Never commit .env.
# In production these come from Cloud Run env vars + Secret Manager (see cloudbuild.yaml).
# Local dev talks to REAL Google Cloud resources in a dev project:
#   - Cloud SQL through the Cloud SQL Auth Proxy  (npm run db:proxy)
#   - Firestore, Firebase Auth and Cloud Storage through Application Default
#     Credentials                                  (gcloud auth application-default login)
# ---------------------------------------------------------------------------

# Public URL of the site (used for Stripe redirect URLs)
SITE_URL=http://localhost:3000

# Comma-separated staff emails allowed into /admin
ADMIN_EMAILS=admin@prairiecrestfoods.example

# --- Google Cloud / Firebase ---------------------------------------------
# Your GCP project id. Firebase must be enabled on this project.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
FIREBASE_PROJECT_ID=your-gcp-project-id
# From Firebase console > Project settings > General > Your apps > Web app
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-gcp-project-id.firebaseapp.com
FIREBASE_APP_ID=
# Cloud Storage bucket for product photos (created by scripts/setup-gcp.sh)
GCS_BUCKET=your-gcp-project-id-product-images

# --- Cloud SQL (PostgreSQL) -----------------------------------------------
# Local dev: run `npm run db:proxy` first, then connect through 127.0.0.1:5432
CLOUD_SQL_CONNECTION_NAME=your-gcp-project-id:us-central1:foodhub-pg
DATABASE_URL=postgresql://app:CHANGE_ME@127.0.0.1:5432/foodhub
# Cloud Run uses the unix socket instead (set by cloudbuild.yaml / Secret Manager):
# DATABASE_URL=postgresql://app:PASSWORD@localhost/foodhub?host=/cloudsql/PROJECT:REGION:INSTANCE

# --- Stripe (test mode) ---------------------------------------------------
# Leave blank to skip the payment step (orders are still recorded as PENDING_PAYMENT).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
